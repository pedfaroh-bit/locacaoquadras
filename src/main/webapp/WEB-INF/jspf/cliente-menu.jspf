<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="mCtx" value="${pageContext.request.contextPath}"/>
<header class="topo">
  <a class="logo" href="${mCtx}/index.jsp"><b>Q</b>QuadraDas</a>

  <nav>
    <a href="${mCtx}/index.jsp" class="${menuAtivo == 'inicio' ? 'ativo' : ''}">Início</a>
    <a href="${mCtx}/list-quadra" class="${menuAtivo == 'quadras' ? 'ativo' : ''}">Quadras</a>
    <a href="${mCtx}/list-reserva" class="${menuAtivo == 'reservas' ? 'ativo' : ''}">Reservas</a>
    <a href="${mCtx}/perfil.jsp" class="${menuAtivo == 'perfil' ? 'ativo' : ''}">Perfil</a>
    <c:if test="${sessionScope.papel == 'ADMIN'}">
      <a href="${mCtx}/administrador.jsp">Painel</a>
    </c:if>
  </nav>

  <c:choose>
    <c:when test="${not empty sessionScope.usuarioLogado}">
      <a class="btn" href="${mCtx}/logout">Sair</a>
    </c:when>
    <c:otherwise>
      <a class="btn" href="${mCtx}/login.jsp">Entrar</a>
    </c:otherwise>
  </c:choose>
</header>