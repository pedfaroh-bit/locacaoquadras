<%@ page pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<header class="topo">
  <a class="logo" href="${ctx}/inicio">
    <b>Q</b>
    <span>QuadraDas</span>
  </a>

  <nav>
    <a class="${menuAtivo == 'quadras' ? 'ativo' : ''}" href="${ctx}/quadras">Quadras</a>
    <a class="${menuAtivo == 'horarios' ? 'ativo' : ''}" href="${ctx}/horarios">Horários</a>
    <a class="${menuAtivo == 'admin-reservas' ? 'ativo' : ''}" href="${ctx}/admin-reservas.jsp">Reservas</a>
    <a class="${menuAtivo == 'admin-usuarios' ? 'ativo' : ''}" href="${ctx}/admin-usuarios.jsp">Usuários</a>
    <a class="${menuAtivo == 'modalidades' ? 'ativo' : ''}" href="${ctx}/modalidades">Modalidades</a>
    <a class="${menuAtivo == 'bloqueios' ? 'ativo' : ''}" href="${ctx}/bloqueio.jsp">Bloqueios</a>
  </nav>

  <a class="btn" href="${ctx}/inicio">Ver site</a>
</header>