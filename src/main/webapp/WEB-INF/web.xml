<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
  <display-name>locacaoquadra</display-name>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Console web do H2: http://localhost:8080/locacaoquadra/console -->
  <servlet>
    <servlet-name>H2Console</servlet-name>
    <servlet-class>org.h2.server.web.WebServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>H2Console</servlet-name>
    <url-pattern>/console/*</url-pattern>
  </servlet-mapping>

  <!-- Roteador de telas para facilitar testes e navegação -->
  <servlet>
    <servlet-name>TelaServlet</servlet-name>
    <servlet-class>com.locacaoquadras.servlet.TelaServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>TelaServlet</servlet-name>
    <url-pattern>/tela</url-pattern>
  </servlet-mapping>

</web-app>